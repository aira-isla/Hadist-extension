{
  "manifest_version": 3,
  "name": "Daily Hadist",
  "author": "aira-isla",
  "version": "1.0.1",
  "description": "Display daily hadith every time you open a new tab or refresh. Stay halal.",

  "permissions": ["tabs"],

  "browser_specific_settings": {
    "gecko": {
      "id": "https://github.com/aira-isla",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
}
